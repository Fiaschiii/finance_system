# Porta do servidor backend
PORT=3000

# URL do frontend (usada para configurar o CORS)
FRONTEND_URL=http://localhost:5173

# Supabase
# Painel do projeto: Settings > API Keys
# Use a "Publishable key" (aba "API Keys", formato sb_publishable_...) — recomendado
# Se seu projeto só tiver a aba "Legacy API Keys", use a chave "anon" por enquanto
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Chave elevada (secret / antiga service_role). O backend NAO usa isso por padrão.
# Só preencha se uma etapa futura pedir explicitamente uma rotina administrativa.
SUPABASE_SECRET_KEY=
