# Porta do servidor backend
PORT=3000

# URL do frontend (usada para configurar o CORS)
FRONTEND_URL=http://localhost:5173

# Ambiente. Em "production" as respostas de erro 500 não mostram o detalhe
# técnico (mensagem do banco etc.). Deixe vazio no seu computador.
NODE_ENV=

# Máximo de requisições por IP a cada 15 minutos (padrão: 300)
RATE_LIMIT_MAX=

# Supabase
# Painel do projeto: Settings > API Keys
# Use a "Publishable key" (aba "API Keys", formato sb_publishable_...) — recomendado
# Se seu projeto só tiver a aba "Legacy API Keys", use a chave "anon" por enquanto
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# NÃO coloque aqui a chave "secret" (antiga service_role): ela ignora o RLS.
# O backend não precisa dela — todas as consultas usam o login do próprio
# usuário, e é isso que faz o RLS valer.
